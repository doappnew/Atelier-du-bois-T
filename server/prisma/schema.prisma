generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Availability {
  AVAILABLE
  OUT_OF_STOCK
  MADE_TO_ORDER
  ON_QUOTE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  IN_PRODUCTION
  READY
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  APPROVED
  COMPLETED
  CANCELLED
  FAILED
}

enum QuoteStatus {
  NEW
  IN_PROGRESS
  ANSWERED
  CLOSED
}

enum DeliveryMode {
  DELIVERY
  PICKUP
}

model User {
  id        String   @id @default(uuid())
  piUid     String   @unique
  username  String
  createdAt DateTime @default(now())

  orders        Order[]
  quoteRequests QuoteRequest[]
  addresses     Address[]
  adminUser     AdminUser?

  @@map("users")
}

// Les droits admin sont donnés uniquement ici, jamais automatiquement.
model AdminUser {
  id        String   @id @default(uuid())
  userId    String   @unique
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_users")
}

model Category {
  id        String  @id @default(uuid())
  name      String  @unique
  slug      String  @unique
  imageUrl  String?
  sortOrder Int     @default(0)

  products Product[]

  @@map("categories")
}

model Product {
  id           String       @id @default(uuid())
  name         String
  slug         String       @unique
  description  String
  pricePi      Decimal?     @db.Decimal(18, 7)
  categoryId   String
  availability Availability @default(AVAILABLE)
  stock        Int?
  dimensions   String?
  woodType     String?
  finish       String?
  published    Boolean      @default(false)
  archived     Boolean      @default(false)
  popular      Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  category   Category       @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([published, archived])
  @@map("products")
}

model ProductImage {
  id        String @id @default(uuid())
  productId String
  url       String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  fullName  String
  phone     String
  address   String
  city      String
  notes     String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

model Order {
  id           String       @id @default(uuid())
  userId       String
  addressId    String?
  deliveryMode DeliveryMode @default(DELIVERY)
  status       OrderStatus  @default(PENDING_PAYMENT)
  deliveryFee  Decimal      @default(0) @db.Decimal(18, 7)
  totalPi      Decimal      @db.Decimal(18, 7)
  paidAt       DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user     User        @relation(fields: [userId], references: [id])
  address  Address?    @relation(fields: [addressId], references: [id])
  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  name      String
  unitPrice Decimal @db.Decimal(18, 7)
  quantity  Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id          String        @id @default(uuid())
  orderId     String
  piPaymentId String        @unique
  txid        String?       @unique
  amount      Decimal       @db.Decimal(18, 7)
  status      PaymentStatus @default(CREATED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("payments")
}

model QuoteRequest {
  id           String      @id @default(uuid())
  userId       String?
  customerName String
  phone        String
  furnitureType String
  dimensions   String?
  woodType     String?
  description  String
  imageUrl     String?
  status       QuoteStatus @default(NEW)
  adminNote    String?
  createdAt    DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([status])
  @@map("quote_requests")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}
