# ===== SERVEUR (server/) — ne jamais mettre ces valeurs dans le frontend =====
NODE_ENV=development
PORT=4000
# URL PostgreSQL (Supabase ou Render)
DATABASE_URL="postgresql://utilisateur:motdepasse@hote:5432/base"
# Clé secrète pour signer les sessions (longue chaîne aléatoire, 32+ caractères)
JWT_SECRET="changez-moi-par-une-longue-chaine-aleatoire"
# Clé API Pi : Developer Portal > votre app > API Key
PI_API_KEY="votre-cle-api-pi"
# Adresse du frontend autorisée (CORS)
CLIENT_ORIGIN="http://localhost:5173"
# Clé de validation de domaine donnée par Pi (servie sur /validation-key.txt)
PI_VALIDATION_KEY=""

# ===== FRONTEND (web/) — valeurs publiques uniquement =====
VITE_API_URL="http://localhost:4000"
# true en test (Sandbox), false en production, selon la doc Pi
VITE_PI_SANDBOX="true"
